<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Phase 2: this is now a real Spring Boot application. The
        spring-boot-starter-parent gives us managed, compatible versions
        for every Spring dependency below (we don't pick versions for
        spring-web/spring-data-jpa ourselves - the parent does it).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.skillgapai</groupId>
    <artifactId>skillgap-ai-backend</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- REST controllers (used starting Phase 3) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JSON (de)serialization for @RestController responses/requests and
             ReportService's storage of match results as JSON text (Phase 4).
             Not pulled in by spring-boot-starter-web automatically on this
             Spring Boot version - has to be added explicitly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- Spring Data JPA: entities + repositories talking to MySQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Resume PDF parsing (Phase 5): extracts plain text from an
             uploaded PDF so it can be fed into the same matching logic
             that already handles pasted text. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.7</version>
        </dependency>

        <!-- MySQL JDBC driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache Commons Text: gives us Levenshtein / Jaro-Winkler string
             similarity so the matcher can tolerate typos and near-spellings
             (e.g. "Sprint Boot" vs "Spring Boot"). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.12.0</version>
        </dependency>

        <!-- Spring Boot's test starter (brings in JUnit 5 + Spring test support) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages the app as a runnable jar and provides "mvn spring-boot:run" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.skillgapai.SkillGapAiApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Kept from Phase 1: lets us still run "mvn exec:java" to try
                 the plain-Java matching demo without Spring involved. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.skillgapai.Phase1Demo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
